// User interface for the Mesh chat client.
//
// Layout: a persistent dark sidebar (identity, connection mode, room
// controls, pending requests, peers) next to a conversation pane, rather
// than switching between separate full-screen steps. The sidebar's room
// controls and peer/request lists are always present; they are simply
// empty until a room exists.

import { LineEdit, ListView, Palette } from "std-widgets.slint";

global Theme {
    out property <color> base: #0B0C0F;      // window background
    out property <color> surface: #111318;   // sidebar / panel background
    out property <color> raised: #1B1E24;    // room-code plate, cards
    out property <color> ink: #E7ECF2;       // primary text
    out property <color> muted: #8A93A0;     // secondary text
    out property <color> line: #262B33;      // borders
    out property <color> signal: #1E9E74;    // connected / primary action
    out property <color> waiting: #D9A441;   // amber - waiting on a human
    out property <color> danger: #E5484D;    // failed / error
    out property <string> mono: "Consolas";
}

export struct MessageRow {
    who: string,
    time: string,
    body: string,
    mine: bool,
    system: bool,
}

export struct PeerRow {
    id: string,
    name: string,
    status: string,
    detail: string,
}

export struct RequestRow {
    req: string,
    name: string,
    addr: string,
    fingerprint: string,
}

export struct TransferRow {
    id: string,
    label: string,
    progress: float,
    state: string,
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> quiet: false;
    in property <bool> active: true;
    callback clicked();

    height: 32px;
    min-width: 96px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.active ? (root.primary ? Theme.signal : Theme.line) : Theme.line;
    background: !root.active
        ? Theme.surface
        : root.primary
            ? (ta.has-hover ? Theme.signal.darker(0.15) : Theme.signal)
            : (ta.has-hover ? Theme.raised : (root.quiet ? transparent : Theme.surface));

    ta := TouchArea {
        mouse-cursor: root.active ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.active) { root.clicked(); }
        }
    }

    Text {
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.label;
        font-size: 13px;
        color: !root.active ? Theme.muted : (root.primary ? #08120D : Theme.ink);
    }
}

// Top navigation tab for the connection mode (LAN / Bluetooth): plain text
// that gets a raised pill behind it once selected, underline-bar style.
component NavTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    height: 30px;
    border-radius: 15px;
    background: root.selected ? Theme.raised : (ta.has-hover ? Theme.surface : transparent);

    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }

    Text {
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.label;
        font-size: 13px;
        color: root.selected ? Theme.ink : Theme.muted;
    }
}

component StatusDot inherits Rectangle {
    in property <string> status;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.status == "Connected"
        ? Theme.signal
        : root.status == "Connecting"
            ? Theme.waiting
            : Theme.danger;
}

component SectionLabel inherits Text {
    font-size: 12px;
    font-weight: 600;
    color: Theme.muted;
    letter-spacing: 0.5px;
}

export component AppWindow inherits Window {
    title: "Mesh-Chat";
    background: Theme.base;
    preferred-width: 1000px;
    preferred-height: 680px;
    min-width: 860px;
    min-height: 600px;

    // Force every std-widgets control (LineEdit, ListView, ...) into its
    // dark variant so they don't render their default light styling
    // against this window's dark background.
    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // --- state driven from Rust -----------------------------------------
    in-out property <string> screen: "setup";      // "setup" | "room"
    in-out property <string> display_name: "";
    in-out property <string> mode: "LAN";          // "LAN" | "Bluetooth"
    in-out property <string> join_code: "";
    in-out property <string> draft: "";

    in property <bool> is_host: false;
    in property <string> room_code: "";
    in property <string> room_addr: "";
    in property <string> transport_label: "";
    in property <string> my_fingerprint: "";
    in property <string> status_line: "";
    in property <string> error_line: "";
    in property <string> expiry_note: "";
    in property <bool> busy: false;

    in property <[MessageRow]> messages;
    in property <[PeerRow]> peers;
    in property <[RequestRow]> requests;
    in property <[TransferRow]> transfers;

    in property <string> offer_id: "";
    in property <string> offer_text: "";

    // Bumped from Rust whenever the transcript gains a line. The ListView
    // lives inside an `if` block further down, and Slint does not let a
    // root-level function reach into an id declared inside a conditional -
    // so instead of calling in, we let the list itself notice this counter
    // change and scroll itself. See the `changed _tick` handler on
    // `chat_list` below.
    in property <int> scroll_tick: 0;

    // --- actions handled in Rust ----------------------------------------
    callback host_room();
    callback join_room();
    callback approve(string, bool);
    callback send_message();
    callback send_file();
    callback export_history();
    callback copy_code();
    callback leave_room();
    callback reopen_joining();
    callback respond_offer(string, bool);

    VerticalLayout {
        // ---------------- title + mode tabs ----------------
        Rectangle {
            background: Theme.surface;
            border-width: 0px;
            VerticalLayout {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 10px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Mesh-Chat";
                            color: Theme.ink;
                            font-size: 16px;
                            font-weight: 600;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "your key " + root.my_fingerprint;
                            color: Theme.muted;
                            font-size: 11px;
                            font-family: Theme.mono;
                            horizontal-alignment: right;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    NavTab {
                        label: "LAN (direct TCP)";
                        width: 150px;
                        selected: root.mode == "LAN";
                        clicked => {
                            if (root.screen == "setup") { root.mode = "LAN"; }
                        }
                    }
                    NavTab {
                        label: "Bluetooth (RFCOMM)";
                        width: 165px;
                        selected: root.mode == "Bluetooth";
                        clicked => {
                            if (root.screen == "setup") { root.mode = "Bluetooth"; }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.line; }
            }
        }

        // ---------------- body: sidebar + conversation ----------------
        HorizontalLayout {
            vertical-stretch: 1;

            // -------- sidebar --------
            Rectangle {
                width: 300px;
                background: Theme.surface;

                ScrollableSidebar := Flickable {
                    viewport-width: parent.width;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 16px;

                        // --- identity ---
                        VerticalLayout {
                            spacing: 6px;
                            SectionLabel { text: "Your display name"; }
                            LineEdit {
                                placeholder-text: "e.g. Alice";
                                text <=> root.display_name;
                                enabled: root.screen == "setup";
                            }
                        }

                        // --- host/join controls, or active room info ---
                        if root.screen == "setup": VerticalLayout {
                            spacing: 12px;

                            VerticalLayout {
                                spacing: 6px;
                                SectionLabel { text: "Host a room"; }
                                Text {
                                    text: "You get a short code to pass on. Every joiner needs your approval.";
                                    wrap: word-wrap;
                                    font-size: 11px;
                                    color: Theme.muted;
                                }
                                ActionButton {
                                    label: "Host a Room";
                                    active: !root.busy;
                                    clicked => { root.host_room(); }
                                }
                            }

                            Rectangle { height: 1px; background: Theme.line; }

                            VerticalLayout {
                                spacing: 6px;
                                SectionLabel { text: "Join with room code"; }
                                LineEdit {
                                    placeholder-text: "L-XXXXX-XXXXX";
                                    text <=> root.join_code;
                                    accepted => { root.join_room(); }
                                }
                                ActionButton {
                                    label: "Request to Join";
                                    active: !root.busy;
                                    clicked => { root.join_room(); }
                                }
                            }

                            if root.error_line != "": Text {
                                text: root.error_line;
                                color: Theme.danger;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }

                        if root.screen == "room": VerticalLayout {
                            spacing: 8px;
                            SectionLabel { text: root.is_host ? "Room code" : "Joined via " + root.transport_label; }

                            Rectangle {
                                height: 52px;
                                background: Theme.raised;
                                border-radius: 4px;
                                Text {
                                    width: 100%;
                                    height: 100%;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    text: root.room_code;
                                    font-family: Theme.mono;
                                    font-size: 19px;
                                    letter-spacing: 2px;
                                    color: Theme.ink;
                                }
                            }

                            if root.is_host: HorizontalLayout {
                                spacing: 8px;
                                ActionButton {
                                    label: "Copy code";
                                    clicked => { root.copy_code(); }
                                }
                                ActionButton {
                                    label: "Reopen joining";
                                    quiet: true;
                                    clicked => { root.reopen_joining(); }
                                }
                            }
                            if root.is_host && root.expiry_note != "": Text {
                                text: root.expiry_note;
                                font-size: 11px;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                        }

                        Rectangle { height: 1px; background: Theme.line; }

                        // --- pending requests ---
                        VerticalLayout {
                            spacing: 8px;
                            SectionLabel { text: "Pending requests"; }
                            if root.requests.length == 0: Text {
                                text: "None";
                                font-size: 12px;
                                color: Theme.muted;
                            }
                            for r in root.requests: Rectangle {
                                background: Theme.raised;
                                border-radius: 4px;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 6px;
                                    Text {
                                        text: r.name;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.ink;
                                    }
                                    Text {
                                        text: "from " + r.addr;
                                        font-size: 10px;
                                        font-family: Theme.mono;
                                        color: Theme.muted;
                                    }
                                    Text {
                                        text: "key " + r.fingerprint;
                                        font-size: 10px;
                                        font-family: Theme.mono;
                                        color: Theme.muted;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        ActionButton {
                                            label: "Accept";
                                            primary: true;
                                            clicked => { root.approve(r.req, true); }
                                        }
                                        ActionButton {
                                            label: "Decline";
                                            clicked => { root.approve(r.req, false); }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.line; }

                        // --- peers ---
                        VerticalLayout {
                            spacing: 6px;
                            SectionLabel { text: "Peers"; }
                            if root.peers.length == 0: Text {
                                text: root.screen == "room"
                                    ? (root.is_host ? "Nobody yet. Share the code above." : "Connecting...")
                                    : "Not connected.";
                                font-size: 12px;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                            for p in root.peers: VerticalLayout {
                                padding-top: 4px;
                                padding-bottom: 4px;
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    VerticalLayout {
                                        alignment: center;
                                        StatusDot { status: p.status; }
                                    }
                                    Text {
                                        text: p.name;
                                        font-size: 13px;
                                        color: Theme.ink;
                                    }
                                    Text {
                                        text: p.status;
                                        font-size: 11px;
                                        color: Theme.muted;
                                        vertical-alignment: bottom;
                                    }
                                }
                                if p.detail != "": Text {
                                    text: p.detail;
                                    font-size: 10px;
                                    font-family: Theme.mono;
                                    color: Theme.muted;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }

                        // --- transcript / file actions, always visible ---
                        Rectangle { height: 1px; background: Theme.line; }
                        VerticalLayout {
                            spacing: 8px;
                            ActionButton {
                                label: "Download Chat History";
                                clicked => { root.export_history(); }
                            }
                            ActionButton {
                                label: "Send File";
                                active: root.screen == "room";
                                clicked => { root.send_file(); }
                            }
                            if root.screen == "room": ActionButton {
                                label: "Leave the room";
                                quiet: true;
                                clicked => { root.leave_room(); }
                            }
                        }
                    }
                }
            }

            // -------- conversation pane --------
            VerticalLayout {
                horizontal-stretch: 1;

                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 14px;
                    padding-bottom: 6px;
                    spacing: 2px;
                    Text {
                        text: "Conversation";
                        font-size: 15px;
                        font-weight: 600;
                        color: Theme.ink;
                    }
                    Text {
                        text: "Messages and files are sent separately to each peer over its own encrypted channel.";
                        font-size: 11px;
                        color: Theme.muted;
                        wrap: word-wrap;
                    }
                }

                chat_list := ListView {
                    vertical-stretch: 1;

                    // Same element as the id above the restriction: a local
                    // property mirroring root's counter, watched with
                    // `changed`, so the scroll happens inside chat_list's own
                    // scope instead of being reached into from outside it.
                    property <int> _tick: root.scroll_tick;
                    changed _tick => {
                        self.viewport-y = min(0px, self.visible-height - self.viewport-height);
                    }

                    for m in root.messages: Rectangle {
                        background: m.mine ? Theme.raised : transparent;
                        VerticalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 1px;
                            if !m.system: HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Text {
                                    text: m.who + ":";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: m.mine ? Theme.signal : Theme.ink;
                                }
                                Text {
                                    text: m.body;
                                    font-size: 13px;
                                    color: Theme.ink;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                            }
                            if m.system: Text {
                                text: m.body;
                                font-size: 12px;
                                font-italic: true;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                if root.transfers.length > 0: Rectangle {
                    background: Theme.surface;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        for t in root.transfers: VerticalLayout {
                            spacing: 3px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: t.label;
                                    font-size: 12px;
                                    color: Theme.ink;
                                    overflow: elide;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: t.state;
                                    font-size: 11px;
                                    color: Theme.muted;
                                }
                            }
                            Rectangle {
                                height: 4px;
                                background: Theme.raised;
                                border-radius: 2px;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * t.progress;
                                    height: 100%;
                                    border-radius: 2px;
                                    background: Theme.signal;
                                }
                            }
                        }
                    }
                }

                if root.offer_id != "": Rectangle {
                    background: Theme.surface;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: root.offer_text;
                                font-size: 13px;
                                color: Theme.ink;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "Nothing is written until you choose where to save it, and nothing is ever opened for you.";
                                font-size: 11px;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 6px;
                            ActionButton {
                                label: "Save file as...";
                                primary: true;
                                clicked => { root.respond_offer(root.offer_id, true); }
                            }
                            ActionButton {
                                label: "Decline";
                                clicked => { root.respond_offer(root.offer_id, false); }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 56px;
                    background: Theme.surface;
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 8px;
                        LineEdit {
                            horizontal-stretch: 1;
                            placeholder-text: root.screen == "room" ? "Write a message" : "Host or join a room to start chatting";
                            enabled: root.screen == "room";
                            text <=> root.draft;
                            accepted => { root.send_message(); }
                        }
                        ActionButton {
                            label: "Send";
                            primary: true;
                            min-width: 78px;
                            active: root.screen == "room";
                            clicked => { root.send_message(); }
                        }
                    }
                }
            }
        }

        // ---------------- status bar ----------------
        Rectangle {
            height: 26px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.status_line;
                        font-size: 11px;
                        color: Theme.muted;
                        overflow: elide;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.screen == "room" ? root.transport_label + " · end to end encrypted (Noise XX)" : "";
                        font-size: 11px;
                        color: Theme.muted;
                    }
                }
            }
        }
    }
}
